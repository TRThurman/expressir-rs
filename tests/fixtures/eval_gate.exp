SCHEMA eval_gate;

  TYPE color_enum = ENUMERATION OF (red, green, blue);
  END_TYPE;

  ENTITY probe;
    holder : STRING;
  DERIVE
    d_int : INTEGER := 3 + 4 * 2;
    d_int_div : INTEGER := 7 DIV 2;
    d_int_div_neg : INTEGER := -7 DIV 2;
    d_mod : INTEGER := 7 MOD 3;
    d_mod_neg : INTEGER := -7 MOD 3;
    d_pow : INTEGER := 2 ** 10;
    d_real_div : REAL := 1 / 4;
    d_real_div_rep : REAL := 1.0 / 3.0;
    d_prec : REAL := 0.1 + 0.2;
    d_concat : STRING := 'foo' + 'bar';
    d_bin_cat : BINARY := %0011 + %1100;
    d_neg : INTEGER := -(x);
    d_neg_real : REAL := -y;
    d_not : LOGICAL := NOT (flag AND TRUE);
    d_rel : LOGICAL := 3 < 5;
    d_le : LOGICAL := 3 <= 3;
    d_ge : LOGICAL := 5 >= 5;
    d_gt : LOGICAL := 2 > 3;
    d_eq_str : LOGICAL := 'abc' = 'abc';
    d_neq : LOGICAL := 2 <> 3;
    d_enum_eq : LOGICAL := col = green;
    d_enum_same : LOGICAL := col = col;
    d_in : LOGICAL := 3 IN items;
    d_in_empty : LOGICAL := 1 IN empty_items;
    d_like_hit : LOGICAL := 'hello' LIKE 'h*l?';
    d_like_miss : LOGICAL := 'hello' LIKE 'h?llo';
    d_interval : LOGICAL := {1 <= x <= 10};
    d_interval_str : LOGICAL := {'a' <= s <= 'zzz'};
    d_and_unk : LOGICAL := flag AND unk;
    d_and_false : LOGICAL := FALSE AND unk;
    d_or_unk : LOGICAL := FALSE OR unk;
    d_xor : LOGICAL := TRUE XOR TRUE;
    d_xor_unk : LOGICAL := unk XOR TRUE;
    d_agg : LIST OF INTEGER := [1, 2, 3];
    d_agg_empty : LIST OF INTEGER := [];
    d_union : LIST OF INTEGER := items + [5];
    d_set_union : SET OF INTEGER := num_set + other_set;
    d_set_diff : SET OF INTEGER := num_set - other_set;
    d_set_inter : SET OF INTEGER := num_set * other_set;
    d_query : INTEGER := SIZEOF(QUERY(v <* items | v > 2));
    d_query_empty : INTEGER := SIZEOF(QUERY(v <* empty_items | v > x));
    d_sizeof : INTEGER := SIZEOF(items);
    d_hiindex : INTEGER := HIINDEX(items);
    d_loindex : INTEGER := LOINDEX(items);
    d_bounds : LIST OF INTEGER := BOUNDS(items);
    d_abs : INTEGER := ABS(neg);
    d_odd_true : LOGICAL := ODD(7);
    d_odd_false : LOGICAL := ODD(8);
    d_length : INTEGER := LENGTH(s);
    d_blength : INTEGER := BLENGTH(b);
    d_exists : LOGICAL := EXISTS(x);
    d_exists_ind : LOGICAL := EXISTS(maybe);
    d_nvl_alt : INTEGER := NVL(maybe, 9);
    d_nvl_val : INTEGER := NVL(x, 9);
    d_value_real : REAL := VALUE(strnum);
    d_value_int : INTEGER := VALUE('42');
    d_typeof : SET OF STRING := TYPEOF(x);
    d_usedin : SET OF STRING := USEDIN(x);
    d_rolesof : SET OF STRING := ROLESOF(x);
    d_valuein_hit : LOGICAL := VALUE_IN(2, num_set);
    d_valuein_miss : LOGICAL := VALUE_IN(9, num_set);
    d_index : INTEGER := items[1];
    d_index_nested : INTEGER := items[2] + 10;
    d_unbound : INTEGER := missing_id + 1;
    d_attr_ref : INTEGER := x.tune;
    d_group_ref : INTEGER := x\e.thing;
    d_indeterminate : INTEGER := maybe + 1;
    d_int_lit : INTEGER := 42;
    d_real_lit : REAL := 1.5;
    d_str_lit : STRING := 'plain';
    d_log_true : LOGICAL := TRUE;
    d_log_false : LOGICAL := FALSE;
    WHERE
      wr1 : x > 0;
      wr2 : s IN ['a', 'b'];
      wr3 : NOT (2 = 3);
      wr4 : flag;
      wr5 : {1 <= y <= 10};
  END_ENTITY;

END_SCHEMA;
